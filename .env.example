# Copie para .env e ajuste. O docker compose lê este arquivo automaticamente.
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio-com-32+caracteres
# Somente dev: em homolog/prod use senha aleatória própria.
# Em volume PostgreSQL existente, altere a senha do usuário no banco antes de mudar esta variável.
DB_PASSWORD=wodz
# Validade do Bearer. Ao vencer, é necessário entrar novamente.
JWT_TTL=12h
SEED_DEMO=true

# disabled (sem pagamentos) | mercadopago (Checkout Pro hospedado, teste ou produção)
PAYMENT_PROVIDER=mercadopago
CHECKOUT_EXPIRATION=30m
# true exige uma conta de vendedor de teste; false exige uma conta real de vendedor.
# Checkout Pro usa APP_USR e init_point em ambos os modos, com identidade conferida por OAuth.
# Para testar localmente: PAYMENT_PROVIDER=mercadopago, APP_ENV=dev e MP_TEST_MODE=true.
MP_TEST_MODE=true
# Aplicação Marketplace da plataforma. Cada organizador autoriza sua própria conta no perfil.
MP_CLIENT_ID=
MP_CLIENT_SECRET=
MP_WEBHOOK_SECRET=
# URL pública que o Mercado Pago chama, ex.: https://seu-dominio.com/api/webhooks/mercadopago
MP_NOTIFICATION_URL=
MP_PLATFORM_FEE_PERCENT=0

# dev | homolog | prod. Em homolog/prod desative o seed e use segredos próprios + HTTPS.
APP_ENV=dev
# Porta publicada pelo frontend Docker. Use outra porta livre se 8081 já estiver em uso.
FRONTEND_HOST_PORT=8081
# No acesso local, ajuste estas URLs se mudar a porta. Com OAuth, use a URL HTTPS do túnel.
FRONTEND_URL=http://localhost:8081
CORS_ORIGINS=http://localhost:8081,http://localhost:5173
# 32 bytes aleatórios em Base64; preserve esta chave para conseguir ler os tokens já conectados.
APP_ENCRYPTION_KEY=
# Redirect URL no Mercado Pago: https://seu-dominio.com/api/public/mercadopago/callback
# Habilite Authorization Code com PKCE (S256) nos detalhes da aplicação.

# Login com Google: Client ID OAuth (tipo "Aplicativo da Web") do Google Cloud.
# Em "Origens JavaScript autorizadas" do Client ID devem estar os endereços do site
# sem caminho (http://localhost:5173, http://localhost:8081 e os domínios publicados).
GOOGLE_CLIENT_ID=84072245662-m7cc1brb2fb7lkv92i9dqm5o1phnagr9.apps.googleusercontent.com

# Em URIs de redirecionamento autorizados do MESMO Client ID do Google:
# http://localhost:5173/api/public/google/callback
# http://localhost:8081/api/public/google/callback
# https://wodzhomolog.onrender.com/api/public/google/callback
# https://prdwodz.onrender.com/api/public/google/callback
# https://probably-power-flannels.ngrok-free.dev/api/public/google/callback
# https://SEU-DOMINIO/api/public/google/callback (inclua a URL HTTPS atual do ngrok)
# As URLs sem /api/public/google/callback não substituem os callbacks neste campo.
# Veja a tabela por ambiente na seção Login Google e redirect_uri_mismatch do README.
