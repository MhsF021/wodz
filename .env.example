# Copie para .env e ajuste. O docker compose lê o .env automaticamente (este arquivo não é lido).
# Nunca coloque credenciais reais aqui: este arquivo vai para o git.
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio-com-32+caracteres
SEED_DEMO=true
# Endereço do site; vira a URL de retorno do Checkout Pro (/pagamento/{código})
FRONTEND_URL=http://localhost:8081

# Checkout Pro do Mercado Pago (obrigatório): Access Token em "Suas integrações > Credenciais".
# Para testes, use a credencial de produção de um usuário de teste vendedor (APP_USR-...) ou uma TEST-...
MP_ACCESS_TOKEN=
# "Assinatura secreta" do painel de webhooks; vazio desliga a validação do x-signature
MP_WEBHOOK_SECRET=
# URL HTTPS pública que o Mercado Pago chama, ex.: https://seu-dominio.com/api/webhooks/mercadopago
MP_NOTIFICATION_URL=

# Login com     Google: Client ID OAuth (tipo "Aplicativo da Web") do Google Cloud.
# Em "Origens JavaScript autorizadas" do Client ID devem estar os endereços do site
# (http://localhost:5173, http://localhost:8081 e o domínio de produção).
GOOGLE_CLIENT_ID=84072245662-m7cc1brb2fb7lkv92i9dqm5o1phnagr9.apps.googleusercontent.com
