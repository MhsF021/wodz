# Copie para .env e ajuste. O docker compose lê este arquivo automaticamente.
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio-com-32+caracteres
SEED_DEMO=true

# sandbox (simulado) | mercadopago (real)
PAYMENT_PROVIDER=sandbox
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_WEBHOOK_SECRET=
# URL pública que o Mercado Pago chama, ex.: https://seu-dominio.com/api/webhooks/mercadopago
MP_NOTIFICATION_URL=
# 3DS 2.0 nos pagamentos com cartão (crédito e débito). Mantenha true, a menos que a conta não suporte.
MP_THREE_D_SECURE=true

# Login com     Google: Client ID OAuth (tipo "Aplicativo da Web") do Google Cloud.
# Em "Origens JavaScript autorizadas" do Client ID devem estar os endereços do site
# (http://localhost:5173, http://localhost:8081 e o domínio de produção).
GOOGLE_CLIENT_ID=84072245662-m7cc1brb2fb7lkv92i9dqm5o1phnagr9.apps.googleusercontent.com
